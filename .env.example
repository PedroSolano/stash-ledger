# Copie para .env e preencha. Esses valores só servem de padrão: tudo pode ser alterado
# nas Configurações do app (gravado em %APPDATA%/stash-ledger/settings.json).

# client_id do seu app registrado na GGG (cliente público, sem client_secret).
MAIN_VITE_POE_CLIENT_ID=

# Redirect URI registrada na GGG. Precisa ser local, com porta.
MAIN_VITE_POE_REDIRECT_URI=http://127.0.0.1:8080/callback

# Contato exigido pela GGG no User-Agent (e-mail ou URL do projeto).
MAIN_VITE_POE_CONTACT=

# Base do poe.ninja. Troque por um proxy com cache se tiver um (ex.: um Cloudflare Worker).
MAIN_VITE_NINJA_BASE_URL=https://poe.ninja
