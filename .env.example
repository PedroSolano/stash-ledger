# Copy to .env and fill in. These are only defaults for development builds: every value can also
# be changed in the app's Settings (saved to %APPDATA%\Stash Ledger\settings.json).

# client_id of your app registered with GGG (public client, no client_secret).
MAIN_VITE_POE_CLIENT_ID=

# Redirect URI registered with GGG. Must be local, with a port.
MAIN_VITE_POE_REDIRECT_URI=http://127.0.0.1:8080/callback

# Contact required by GGG in the User-Agent (email or project URL).
MAIN_VITE_POE_CONTACT=

# poe.ninja base URL. Replace with a caching proxy if you have one (e.g. a Cloudflare Worker).
MAIN_VITE_NINJA_BASE_URL=https://poe.ninja
