{
  "name": "stash-ledger",
  "productName": "Exiles Companion",
  "version": "0.8.0",
  "description": "Exile's Companion: Path of Exile stash value, price check, trade search and in-game hotkeys. Runs locally, no backend.",
  "private": true,
  "type": "module",
  "author": "PedroSolano",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroSolano/stash-ledger.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "neverthrow": "^8.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
