{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exile's Companion",
  "mainBinaryName": "exiles-companion",
  "version": "../package.json",
  "identifier": "app.stashledger.desktop",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exile's Companion",
        "visible": false,
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "skipTaskbar": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://web.poecdn.com https://poe.ninja; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Path of Exile companion: stash value, price check, trade search and in-game hotkeys",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3N0NENUNFMTY2MkREOTkKUldTWjNXSVd6dFY4SjVDWVRCSFY1d2Y0MDA2U2pFb2ZZblNCRUxoNEEzdmZVb0FUY0orSGJBd2QK",
      "endpoints": ["https://github.com/PedroSolano/stash-ledger/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
